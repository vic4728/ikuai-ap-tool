# 编译缓存
__pycache__/
*.py[cod]
*$py.class

# 加密配置文件（含密码，绝不入库）
ikuai_config.json

# 旧版明文配置（如有）
gui_config.json

# 运行产物：日志与截图
output/*.log
output/*.txt
output/*.png

# 临时脚本
_fix_bats.py

# 测试脚本（离线可跑，不含凭据，保留入库）
# _guitest.py / _parsetest.py / _threadtest.py / _schematest.py 保留

# 真机验证脚本 —— 必须传真实密码，一律不入库，用完即删
_e2e_*.py

# 一次性诊断/调试脚本（含真实设备地址/凭据，绝不入库）
_diag_*.py
_*_assets/

# 临时备份目录（清理诊断脚本前留的兜底副本，含明文凭据）
_backup_diag_*/

# 虚拟环境
.venv/
.venv-gui/
env/
venv/

# PyInstaller 打包产物（exe 体积大，不入库；需要时用 scripts\打包exe.bat 重打）
build/
dist/
*.spec

# 编辑器
.vscode/
.idea/
*.swp

# 系统
Thumbs.db
desktop.ini
.DS_Store
